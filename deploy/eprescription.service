[Unit]
Description=MedSign e-prescription API
After=network.target

[Service]
User=eprescription
WorkingDirectory=/opt/eprescription/api
ExecStart=/usr/bin/dotnet /opt/eprescription/api/EPrescription.Api.dll
EnvironmentFile=/etc/eprescription/env
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/eprescription/data
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
